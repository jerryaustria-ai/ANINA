# ANINA Booking API — environment
# Copy to `.env` and fill in. `.env` is gitignored.

PORT=4000
MONGO_DB_NAME=ANINA
XENDIT_SIMULATION=true
APP_TIMEZONE=Asia/Manila

# Local MongoDB (Homebrew service). Swap to a hosted URI (e.g. Atlas) to go live.
MONGO_URI=mongodb://127.0.0.1:27017/anina

# Secret for signing our own session JWTs. Use a long random string.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Google OAuth — create a Web-application OAuth Client ID at
# https://console.cloud.google.com/apis/credentials
# Add http://localhost:5173 as an authorized JavaScript origin.
# The SAME id goes in the frontend (app/.env as VITE_GOOGLE_CLIENT_ID).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Optional Facebook Login. Create a Facebook Login app and use the same App ID
# in app/.env as VITE_FACEBOOK_APP_ID. Never expose FACEBOOK_APP_SECRET.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Comma-separated emails that become ANINA Admin automatically on first login.
ADMIN_EMAILS=patrick.ong.wong@gmail.com

# Where the frontend runs (for CORS).
CLIENT_ORIGIN=http://localhost:5173

# App URL used for Xendit success/cancel return links.
# Xendit requires a publicly reachable HTTPS URL, even when the UI is opened locally.
APP_BASE_URL=https://your-app.onrender.com

# --- Xendit subscriptions ---
# Leave XENDIT_SECRET_KEY empty to run billing in SIMULATION mode (no external
# calls; clients "complete" payment via the in-app dev button). Set a
# development key (xnd_development_...) to hit the real Xendit sandbox.
XENDIT_SECRET_KEY=
XENDIT_API_BASE=https://api.xendit.co
# Shared secret to verify incoming webhooks (set the same value in Xendit).
XENDIT_WEBHOOK_TOKEN=

# Guest package checkout totals are treated as VAT-inclusive. Use 0.12 for 12%.
VAT_RATE=0

# Optional transactional booking receipt/confirmation delivery via SMTP.
# Brevo example: use your SMTP login and SMTP key (not your API key).
# All SMTP values and EMAIL_FROM are required; otherwise the booking still
# completes and the purchase is marked emailStatus=skipped.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=ANINA Wellness Sanctuary <bookings@your-verified-domain.com>
EMAIL_LOGO_URL=https://your-app.onrender.com/assets/images/anina-logo.png
SUPPORT_EMAIL=support@your-domain.com
SUPPORT_PHONE=+63 917 000 0000
ALLOW_ADMIN_DUPLICATE_PURCHASE=false
